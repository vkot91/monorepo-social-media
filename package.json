{
  "name": "social-media-new",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run lint typecheck test:coverage build",
    "check:affected": "turbo run lint typecheck test:coverage build --affected",
    "ci": "pnpm check",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "prepare": "husky",
    "test": "turbo run test",
    "test:db:migrate": "turbo run test:db:migrate --filter=@social/database",
    "test:db:reset": "pnpm --filter @social/database test:db:reset",
    "test:infra:down": "docker compose -f docker-compose.test.yml down",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@social/prettier-config": "workspace:*",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "turbo": "^2.9.6",
    "typescript": "^5.5.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
